# Server-side only — the URL of the agent-core backend (FastAPI/Django on Render).
# NEVER prefix with NEXT_PUBLIC_ (keeps it off the browser, avoids CORS).
# Route handlers in app/api/* read this; if unreachable, the UI falls back to mock data.
AGENT_CORE_URL=http://localhost:8000

# Public site name (safe to expose to the browser).
NEXT_PUBLIC_SITE_NAME=Recruiter Agent
